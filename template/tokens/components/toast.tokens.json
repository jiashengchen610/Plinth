{
  "toast": {
    "radius": {
      "$type": "dimension",
      "$value": "{radius.container}"
    },
    "shadow": {
      "$type": "shadow",
      "$value": "{shadow.overlay}"
    },
    "$type": "color",
    "default": {
      "background": {
        "$value": "{color.popover}"
      },
      "foreground": {
        "$value": "{color.popover-foreground}"
      },
      "border": {
        "$value": "{color.border}"
      },
      "description": {
        "$value": "{color.muted-foreground}"
      }
    },
    "destructive": {
      "background": {
        "$value": "{color.destructive}"
      },
      "foreground": {
        "$value": "{color.background}"
      },
      "border": {
        "$value": "{color.destructive}"
      },
      "description": {
        "$value": "{color.background}"
      }
    },
    "title": {
      "font": {
        "$type": "typography",
        "$value": "{typography.label.md}",
        "$description": "Toast title"
      }
    },
    "description": {
      "font": {
        "$type": "typography",
        "$value": "{typography.body.md}",
        "$description": "Toast text"
      }
    },
    "action": {
      "font": {
        "$type": "typography",
        "$value": "{typography.label.md}",
        "$description": "Toast action button"
      }
    }
  }
}
