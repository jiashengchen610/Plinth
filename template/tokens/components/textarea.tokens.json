{
  "textarea": {
    "radius": {
      "$type": "dimension",
      "$value": "{radius.multiline}"
    },
    "$type": "color",
    "field": {
      "background": {
        "$value": "{color.background}",
        "$extensions": {
          "plinth": {
            "modes": {
              "dark": "{color.input}"
            },
            "alpha": {
              "default": 0,
              "dark": 0.3
            }
          }
        }
      },
      "foreground": {
        "$value": "{color.foreground}"
      },
      "border": {
        "$value": "{color.input}"
      },
      "placeholder": {
        "$value": "{color.muted-foreground}"
      },
      "font": {
        "$type": "typography",
        "$value": "{typography.body.md}",
        "$description": "What people type (16px on phones, so iOS does not zoom)"
      }
    }
  }
}
