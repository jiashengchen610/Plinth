{
  "tabs": {
    "radius": {
      "$type": "dimension",
      "$value": "{radius.control}"
    },
    "$type": "color",
    "list": {
      "background": {
        "$value": "{color.muted}"
      },
      "foreground": {
        "$value": "{color.muted-foreground}"
      }
    },
    "trigger": {
      "active-background": {
        "$value": "{color.background}",
        "$extensions": {
          "plinth": {
            "modes": {
              "dark": "{color.input}"
            },
            "alpha": {
              "dark": 0.3
            }
          }
        }
      },
      "active-foreground": {
        "$value": "{color.foreground}"
      },
      "font": {
        "$type": "typography",
        "$value": "{typography.label.md}",
        "$description": "Tab names"
      }
    }
  }
}
