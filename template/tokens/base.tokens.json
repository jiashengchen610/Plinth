{
  "radius": {
    "$type": "dimension",
    "control": {
      "$value": "{radius.lg}",
      "$description": "Buttons, inputs and other controls"
    },
    "container": {
      "$value": "{radius.xl}",
      "$description": "Cards, panels, dialogs"
    },
    "pill": {
      "$value": "{radius.full}",
      "$description": "Badges and tags"
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": [
        "Geist",
        "sans-serif"
      ]
    }
  },
  "typography": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": [
          "Geist",
          "sans-serif"
        ],
        "fontSize": {
          "value": 2,
          "unit": "rem"
        },
        "fontWeight": 600,
        "lineHeight": 1.15,
        "letterSpacing": {
          "value": -0.02,
          "unit": "em"
        }
      }
    },
    "body": {
      "$value": {
        "fontFamily": [
          "Geist",
          "sans-serif"
        ],
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": 400,
        "lineHeight": 1.5
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": "{shadow.xs}",
      "$description": "Resting surfaces"
    },
    "overlay": {
      "$value": "{shadow.lg}",
      "$description": "Menus, popovers, dialogs"
    }
  },
  "ease": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    }
  },
  "motion": {
    "$type": "transition",
    "fast": {
      "$value": {
        "duration": {
          "value": 150,
          "unit": "ms"
        },
        "timingFunction": "{ease.standard}"
      }
    }
  }
}
