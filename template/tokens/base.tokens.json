{
  "radius": {
    "$type": "dimension",
    "control": {
      "$value": "{radius.lg}",
      "$description": "Buttons, inputs and other controls"
    },
    "container": {
      "$value": "{radius.xl}",
      "$description": "Cards, panels, dialogs"
    },
    "pill": {
      "$value": "{radius.full}",
      "$description": "Badges and tags"
    },
    "small": {
      "$value": "{radius.sm}",
      "$description": "Checkboxes, tooltips and other small marks"
    },
    "multiline": {
      "$value": "{radius.lg}",
      "$description": "Fields with several lines (text boxes, message boxes): as round as fields, but never pill-shaped"
    },
    "fit-inside": {
      "$type": "number",
      "$value": 1,
      "$description": "1: parts inside a rounded container (tabs in the tab bar, options in a menu, close buttons in a corner) take its corners minus the gap, so the space between stays even. 0: they keep their own corners."
    }
  },
  "font": {
    "$type": "fontFamily",
    "$description": "Font roles: which font each kind of text uses. They point at fonts in the palette (tokens/primitives.tokens.json → font).",
    "body": {
      "$value": "{font.geist}",
      "$description": "Running text, fields and lists"
    },
    "heading": {
      "$value": "{font.body}",
      "$description": "Headings and titles: the same as body until another font is picked"
    },
    "label": {
      "$value": "{font.body}",
      "$description": "Buttons, tabs, badges and field labels: follows body or heading"
    },
    "code": {
      "$value": "{font.geist-mono}",
      "$description": "Code"
    },
    "sans": {
      "$value": "{font.body}",
      "$description": "Tailwind's font-sans: the page's default font"
    },
    "mono": {
      "$value": "{font.code}",
      "$description": "Tailwind's font-mono"
    }
  },
  "typography": {
    "$type": "typography",
    "$description": "Text styles. Each uses a font role; components point at these through their own text tokens (tokens/components).",
    "display": {
      "$value": {
        "fontFamily": "{font.heading}",
        "fontSize": {
          "value": 2,
          "unit": "rem"
        },
        "fontWeight": 600,
        "lineHeight": 1.15,
        "letterSpacing": {
          "value": -0.02,
          "unit": "em"
        }
      },
      "$description": "Big numbers and page titles"
    },
    "heading": {
      "lg": {
        "$value": {
          "fontFamily": "{font.heading}",
          "fontSize": {
            "value": 1.5,
            "unit": "rem"
          },
          "fontWeight": 600,
          "lineHeight": 1.25,
          "letterSpacing": {
            "value": -0.01,
            "unit": "em"
          }
        },
        "$description": "Section titles"
      },
      "md": {
        "$value": {
          "fontFamily": "{font.heading}",
          "fontSize": {
            "value": 1.125,
            "unit": "rem"
          },
          "fontWeight": 600,
          "lineHeight": 1.35,
          "letterSpacing": {
            "value": 0,
            "unit": "em"
          }
        },
        "$description": "Dialog titles"
      },
      "sm": {
        "$value": {
          "fontFamily": "{font.heading}",
          "fontSize": {
            "value": 1,
            "unit": "rem"
          },
          "fontWeight": 500,
          "lineHeight": 1.375,
          "letterSpacing": {
            "value": 0,
            "unit": "em"
          }
        },
        "$description": "Card titles"
      },
      "xs": {
        "$value": {
          "fontFamily": "{font.heading}",
          "fontSize": {
            "value": 0.875,
            "unit": "rem"
          },
          "fontWeight": 500,
          "lineHeight": 1.375,
          "letterSpacing": {
            "value": 0,
            "unit": "em"
          }
        },
        "$description": "Small card titles"
      }
    },
    "body": {
      "lg": {
        "$value": {
          "fontFamily": "{font.body}",
          "fontSize": {
            "value": 1,
            "unit": "rem"
          },
          "fontWeight": 400,
          "lineHeight": 1.5,
          "letterSpacing": {
            "value": 0,
            "unit": "em"
          }
        },
        "$description": "Longer reading text"
      },
      "md": {
        "$value": {
          "fontFamily": "{font.body}",
          "fontSize": {
            "value": 0.875,
            "unit": "rem"
          },
          "fontWeight": 400,
          "lineHeight": 1.5,
          "letterSpacing": {
            "value": 0,
            "unit": "em"
          }
        },
        "$description": "Most text: descriptions, fields, lists"
      },
      "sm": {
        "$value": {
          "fontFamily": "{font.body}",
          "fontSize": {
            "value": 0.75,
            "unit": "rem"
          },
          "fontWeight": 400,
          "lineHeight": 1.35,
          "letterSpacing": {
            "value": 0,
            "unit": "em"
          }
        },
        "$description": "Small print and tooltips"
      }
    },
    "label": {
      "md": {
        "$value": {
          "fontFamily": "{font.label}",
          "fontSize": {
            "value": 0.875,
            "unit": "rem"
          },
          "fontWeight": 500,
          "lineHeight": 1.25,
          "letterSpacing": {
            "value": 0,
            "unit": "em"
          }
        },
        "$description": "Buttons, tabs and field labels"
      },
      "sm": {
        "$value": {
          "fontFamily": "{font.label}",
          "fontSize": {
            "value": 0.75,
            "unit": "rem"
          },
          "fontWeight": 500,
          "lineHeight": 1.35,
          "letterSpacing": {
            "value": 0,
            "unit": "em"
          }
        },
        "$description": "Badges and small buttons"
      }
    },
    "code": {
      "md": {
        "$value": {
          "fontFamily": "{font.code}",
          "fontSize": {
            "value": 0.8125,
            "unit": "rem"
          },
          "fontWeight": 400,
          "lineHeight": 1.5,
          "letterSpacing": {
            "value": 0,
            "unit": "em"
          }
        },
        "$description": "Code"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": "{shadow.xs}",
      "$description": "Resting surfaces. Dark mode: a deeper shadow plus a faint top highlight, since shadows alone barely show on dark.",
      "$extensions": {
        "plinth": {
          "modes": {
            "dark": [
              {
                "offsetX": {
                  "value": 0,
                  "unit": "px"
                },
                "offsetY": {
                  "value": 1,
                  "unit": "px"
                },
                "blur": {
                  "value": 2,
                  "unit": "px"
                },
                "spread": {
                  "value": 0,
                  "unit": "px"
                },
                "color": "oklch(0 0 0 / 0.5)"
              },
              {
                "offsetX": {
                  "value": 0,
                  "unit": "px"
                },
                "offsetY": {
                  "value": 1,
                  "unit": "px"
                },
                "blur": {
                  "value": 0,
                  "unit": "px"
                },
                "spread": {
                  "value": 0,
                  "unit": "px"
                },
                "color": "oklch(1 0 0 / 0.06)",
                "inset": true
              }
            ]
          }
        }
      }
    },
    "overlay": {
      "$value": "{shadow.lg}",
      "$description": "Menus, pop-ups, dialogs, toasts. Dark mode: deeper, with a faint top highlight.",
      "$extensions": {
        "plinth": {
          "modes": {
            "dark": [
              {
                "offsetX": {
                  "value": 0,
                  "unit": "px"
                },
                "offsetY": {
                  "value": 10,
                  "unit": "px"
                },
                "blur": {
                  "value": 24,
                  "unit": "px"
                },
                "spread": {
                  "value": -4,
                  "unit": "px"
                },
                "color": "oklch(0 0 0 / 0.6)"
              },
              {
                "offsetX": {
                  "value": 0,
                  "unit": "px"
                },
                "offsetY": {
                  "value": 4,
                  "unit": "px"
                },
                "blur": {
                  "value": 8,
                  "unit": "px"
                },
                "spread": {
                  "value": -4,
                  "unit": "px"
                },
                "color": "oklch(0 0 0 / 0.5)"
              },
              {
                "offsetX": {
                  "value": 0,
                  "unit": "px"
                },
                "offsetY": {
                  "value": 1,
                  "unit": "px"
                },
                "blur": {
                  "value": 0,
                  "unit": "px"
                },
                "spread": {
                  "value": 0,
                  "unit": "px"
                },
                "color": "oklch(1 0 0 / 0.08)",
                "inset": true
              }
            ]
          }
        }
      }
    }
  },
  "ease": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    },
    "enter": {
      "$value": [
        0,
        0,
        0.2,
        1
      ],
      "$description": "Things appearing: fast start, gentle stop"
    },
    "exit": {
      "$value": [
        0.4,
        0,
        1,
        1
      ],
      "$description": "Things leaving: gentle start, fast end"
    }
  },
  "motion": {
    "$type": "transition",
    "fast": {
      "$value": {
        "duration": {
          "value": 150,
          "unit": "ms"
        },
        "timingFunction": "{ease.standard}"
      }
    }
  },
  "duration": {
    "$type": "duration",
    "$description": "How long movement takes. Set to 0 when the system asks for reduced motion.",
    "fast": {
      "$value": {
        "value": 120,
        "unit": "ms"
      },
      "$description": "Hover, press, small toggles"
    },
    "normal": {
      "$value": {
        "value": 200,
        "unit": "ms"
      },
      "$description": "Menus, tooltips, toasts"
    },
    "slow": {
      "$value": {
        "value": 300,
        "unit": "ms"
      },
      "$description": "Dialogs and large panels"
    }
  },
  "layer": {
    "$type": "number",
    "$description": "Stacking order of floating things (z-index)",
    "sticky": {
      "$value": 10
    },
    "dropdown": {
      "$value": 50,
      "$description": "Menus, select lists, pop-overs"
    },
    "dialog": {
      "$value": 60,
      "$description": "Dialogs and their backdrop"
    },
    "toast": {
      "$value": 70
    },
    "tooltip": {
      "$value": 80
    }
  },
  "spacing": {
    "$type": "dimension",
    "$value": {
      "value": 0.25,
      "unit": "rem"
    },
    "$description": "Density: the step every padding, gap and margin is a multiple of (p-4 = 4 steps)."
  },
  "material": {
    "$type": "color",
    "$description": "Materials: surfaces with an effect. Glass is a recipe of parameters ($extensions.plinth.glass); Plinth writes the CSS (the material-glass utility) and checks its text over the darkest and the lightest backdrop.",
    "glass": {
      "$value": "{color.popover}",
      "$description": "Glass: the color it tints what is behind it with, and shows solid where the browser cannot blur or the system asks for less transparency",
      "$extensions": {
        "plinth": {
          "glass": {
            "tintOpacity": 0.7,
            "blur": 16,
            "saturation": 1.6,
            "highlight": 0.6,
            "distortion": 0
          }
        }
      }
    },
    "glass-foreground": {
      "$value": "{color.popover-foreground}",
      "$description": "Text on glass"
    }
  }
}
