{
  "$schema": "https://tr.designtokens.org/format/",
  "$extensions": {
    "ds-skills": {
      "exportedAt": "2026-10-02T05:00:00.000Z",
      "exporter": "fixture (simulates export-tokens-figma convert-tokens.mjs --format dtcg)",
      "figmaFileKey": "FIXTURE",
      "note": "Replace with a real export: run the export-tokens-figma skill against the shadcn kit file."
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": "oklch(1 0 0)",
      "$extensions": { "figma-console-mcp": { "variableId": "VariableID:1:1", "modes": { "dark": "oklch(0.145 0 0)" } } }
    },
    "foreground": {
      "$value": "oklch(0.145 0 0)",
      "$extensions": { "figma-console-mcp": { "variableId": "VariableID:1:2", "modes": { "dark": "oklch(0.985 0 0)" } } }
    },
    "primary": {
      "$value": "oklch(0.205 0 0)",
      "$extensions": { "figma-console-mcp": { "variableId": "VariableID:1:3", "modes": { "dark": "oklch(0.922 0 0)" } } }
    },
    "primary-foreground": {
      "$value": "oklch(0.985 0 0)",
      "$extensions": { "figma-console-mcp": { "variableId": "VariableID:1:4", "modes": { "dark": "oklch(0.205 0 0)" } } }
    },
    "destructive": {
      "$description": "DS-001: darkened from the shadcn default (oklch(0.577 0.245 27.325)) so the 10% tint passes AA.",
      "$value": "oklch(0.5 0.22 27)",
      "$extensions": { "figma-console-mcp": { "variableId": "VariableID:1:5", "modes": { "dark": "oklch(0.704 0.191 22.216)" } } }
    },
    "brand": {
      "$description": "New brand accent that has no shadcn counterpart; exercises the new-variable and @theme paths.",
      "$value": { "colorSpace": "srgb", "components": [0.17, 0.42, 0.87], "alpha": 1, "hex": "#2b6bde" },
      "$extensions": { "figma-console-mcp": { "variableId": "VariableID:1:6", "modes": { "dark": "#5b8ff0" } } }
    },
    "brand-foreground": {
      "$value": "{color.background}",
      "$extensions": { "figma-console-mcp": { "variableId": "VariableID:1:7" } }
    }
  },
  "radius": {
    "base": {
      "$type": "dimension",
      "$value": { "value": 0.625, "unit": "rem" },
      "$extensions": { "figma-console-mcp": { "variableId": "VariableID:2:1" } }
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["Geist Variable", "sans-serif"]
    }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$description": "Composite token: Figma cannot hold this as a variable; the token layer can.",
      "$value": { "color": "{color.foreground}", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
      "$extensions": { "ds-skills": { "source": "code" } }
    },
    "overlay": {
      "$type": "shadow",
      "$value": [
        { "color": "#0000001f", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "-4px" },
        { "color": "#0000000f", "offsetX": "0px", "offsetY": "2px", "blur": "6px", "spread": "0px" }
      ]
    }
  },
  "gradient": {
    "hero": {
      "$type": "gradient",
      "$value": { "angle": "135deg", "stops": [ { "color": "{color.brand}", "position": 0 }, { "color": "{color.primary}", "position": 1 } ] }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": { "fontFamily": ["Geist Variable", "sans-serif"], "fontSize": { "value": 2, "unit": "rem" }, "fontWeight": 600, "lineHeight": 1.15, "letterSpacing": { "value": -0.02, "unit": "em" } }
    }
  },
  "ease": {
    "snappy": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
  },
  "motion": {
    "fast": {
      "$type": "transition",
      "$value": { "duration": { "value": 150, "unit": "ms" }, "timingFunction": "{ease.snappy}" }
    }
  }
}
