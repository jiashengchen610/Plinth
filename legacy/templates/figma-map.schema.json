{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-system-skills/schemas/figma-map.json",
  "title": "figma-map.json — Figma ↔ code component mapping",
  "type": "object",
  "required": ["version", "components"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "figma": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fileKey": { "type": "string" },
        "libraryName": { "type": "string" },
        "lastSyncedAt": { "type": "string", "format": "date-time" }
      }
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/componentMapping" }
    },
    "unmapped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["figma", "reason", "decision"],
        "additionalProperties": false,
        "properties": {
          "figma": { "$ref": "#/$defs/figmaRef" },
          "reason": { "type": "string" },
          "decision": { "type": "string", "enum": ["pending", "create", "skip"] },
          "seenAt": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "figmaRef": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "componentKey": { "type": "string" },
        "nodeId": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
        "url": { "type": "string" }
      }
    },
    "componentMapping": {
      "type": "object",
      "required": ["figma", "code", "source"],
      "additionalProperties": false,
      "properties": {
        "figma": { "$ref": "#/$defs/figmaRef" },
        "code": {
          "type": "object",
          "required": ["component", "import"],
          "additionalProperties": false,
          "properties": {
            "component": { "type": "string" },
            "import": { "type": "string" },
            "path": { "type": "string" },
            "storyId": { "type": "string" }
          }
        },
        "props": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["figma", "code"],
            "additionalProperties": false,
            "properties": {
              "figma": {
                "type": "object",
                "required": ["name", "type"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string" },
                  "type": { "type": "string", "enum": ["VARIANT", "BOOLEAN", "TEXT", "INSTANCE_SWAP", "SLOT"] }
                }
              },
              "code": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "prop": { "type": ["string", "null"] },
                  "transform": { "type": "string", "description": "leading-icon | trailing-icon | state | slot:<name> | custom:<note>" }
                }
              },
              "values": {
                "type": "object",
                "description": "Figma option label → code value. null = no code equivalent (visual state). object = multiple props.",
                "additionalProperties": { "type": ["string", "number", "boolean", "object", "null"] }
              }
            }
          }
        },
        "children": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["figma", "code"],
            "additionalProperties": false,
            "properties": {
              "figma": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "nodeId": { "type": "string" } } },
              "code": { "type": "object", "properties": { "slot": { "type": "string" }, "component": { "type": "string" } } }
            }
          }
        },
        "codeConnect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": { "type": "string", "enum": ["local", "published", "unsupported", "failed"] },
            "templatePath": { "type": ["string", "null"] },
            "publishedAt": { "type": ["string", "null"] },
            "error": { "type": "string" }
          }
        },
        "source": { "type": "string", "enum": ["confirmed", "suggested", "code-connect"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "notes": { "type": "string" }
      }
    }
  }
}
